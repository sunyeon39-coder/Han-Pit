rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // app_config.js 의 ADMIN_EMAILS 와 동기화 (Firestore 는 JS 모듈을 import 할 수 없음)
    function isAdminEmailToken() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "sunyeon9501@gmail.com";
    }

    // app shared/auth-helpers.js — hasAnyDirectEventAllow 와 동기화
    function hasDirectEventAllow() {
      return userDocExists() && (
        userDoc().data.get('allowedEvents', {}).size() > 0 ||
        userDoc().data.get('opsTournamentIds', []).size() > 0
      );
    }

    function isDirectOpsAdminRole() {
      return userDocExists() &&
        userDoc().data.get('role', 'user') == 'admin';
    }

    function isAdmin() {
      return signedIn() && (
        isAdminEmailToken() ||
        hasDirectEventAllow() ||
        isDirectOpsAdminRole()
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roleUnchanged() {
      return !("role" in request.resource.data) ||
        !("role" in resource.data) ||
        request.resource.data.role == resource.data.role;
    }

    // 누락 필드와 {} / "" 를 동일하게 취급 (FCM 토큰만 있는 users/{uid} stub → 로그인 setDoc 시 오탐 방지)
    function accessFieldsUnchanged() {
      return (
        request.resource.data.get('accessCode', '') == resource.data.get('accessCode', '') &&
        request.resource.data.get('allowedEvents', {}) == resource.data.get('allowedEvents', {}) &&
        request.resource.data.get('opsTournamentIds', []) == resource.data.get('opsTournamentIds', [])
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isAdmin() ||
        (
          isSelf(uid) &&
          roleUnchanged() &&
          accessFieldsUnchanged()
        );
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }

      // NEW: global integrated seats for admin operations
      match /global_seats/{seatDocId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }

      // 좌석 삭제 후 같은 카드/라벨로 재생성 시 배치 이력을 이어주기 위한 보관소
      match /global_seats_archive/{archiveDocId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }

      match /dealer_pay_profiles/{uid} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /layout_events/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /layout_shared/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /layout_notifications/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin() ||
        (
          isSelf(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["acknowledged", "acknowledgedAt", "updatedAt", "updatedAtServer"])
        );
      allow delete: if isAdmin();
    }

    match /dealer_attendance/{docId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() ||
        (
          signedIn() &&
          docId.matches('.*__' + request.auth.uid) &&
          // 문서 안의 uid 필드도 docId 와 같은 사람이어야 한다 — docId 는 본인 것인데
          // uid 필드만 다른 사람 걸로 써넣는 걸 막는다.
          (!("uid" in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
          // 본인 스스로는 미래 시각으로 출퇴근 시각을 조작할 수 없다(클라이언트 검증과 동일한
          // 규칙을 서버에도 둔다 — 미래 제한은 앱 UI에도 이미 있는 정책이라 정상 사용을 막지 않는다).
          (
            !("checkedInAt" in request.resource.data) ||
            request.resource.data.checkedInAt == null ||
            request.resource.data.checkedInAt <= request.time.toMillis() + 60000
          ) &&
          (
            !("checkedOutAt" in request.resource.data) ||
            request.resource.data.checkedOutAt == null ||
            request.resource.data.checkedOutAt <= request.time.toMillis() + 60000
          )
        );
    }

    match /dealer_attendance_logs/{logId} {
      allow read: if signedIn();
      // 로그는 근무 요약·인건비 계산의 근거 데이터라, 아무나 아무 uid/action 으로나
      // 쓸 수 있으면 본인/타인의 근무 시간을 조작할 수 있었다(예전 규칙은 signedIn() 이면
      // 전부 허용). admin(운영 권한 보유자)은 그대로 자유롭게 쓰되, 일반 로그인 사용자는
      // (1) 본인 uid 로만, (2) 스스로 발생시킬 수 있는 활동 종류로만, (3) 미래 시각이 아닌
      // createdAt 으로만 쓸 수 있게 제한한다. adjust_check_in/adjust_check_out/
      // adjust_work_session/delete_work_session 처럼 "기록을 고치는" 로그는 앱에서도
      // 운영 권한(canShowTournamentOpsUi)이 있어야만 버튼이 뜨므로 admin 전용으로 맞춘다.
      allow create: if signedIn() &&
        request.resource.data.uid is string &&
        request.resource.data.uid.size() > 0 &&
        request.resource.data.tournamentId is string &&
        request.resource.data.tournamentId.size() > 0 &&
        request.resource.data.action is string &&
        request.resource.data.createdAt is int &&
        (
          isAdmin() ||
          (
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.action in
              ["checked_in", "waiting", "checked_out", "operational_day_reset"] &&
            request.resource.data.createdAt <= request.time.toMillis() + 300000
          )
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // HAN 지원서: 본인만 작성, admin 만 열람·수정·삭제
    // 참고: rules 의 string.size() 는 UTF-8 바이트 길이(글자 수 아님). 한글 필드는 한도를 넉넉히 둔다.
    match /han_applications/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "applicantUid",
          "applicantEmail",
          "name",
          "age",
          "gender",
          "phone",
          "experience",
          "createdAt"
        ]) &&
        request.resource.data.applicantUid == request.auth.uid &&
        request.resource.data.applicantEmail is string &&
        request.resource.data.applicantEmail.size() <= 320 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 400 &&
        request.resource.data.age is string &&
        request.resource.data.age.size() >= 1 &&
        request.resource.data.age.size() <= 60 &&
        request.resource.data.gender is string &&
        request.resource.data.gender.size() >= 1 &&
        request.resource.data.gender.size() <= 60 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 1 &&
        request.resource.data.phone.size() <= 80 &&
        request.resource.data.experience is string &&
        request.resource.data.experience.size() >= 1 &&
        request.resource.data.experience.size() <= 600 &&
        request.resource.data.createdAt is int &&
        request.resource.data.createdAt > 0 &&
        request.resource.data.createdAt <= request.time.toMillis() + 300000;
      allow update, delete: if isAdmin();
    }
  }
}
