rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // app_config.js 의 ADMIN_EMAILS 와 동기화 (Firestore 는 JS 모듈을 import 할 수 없음)
    function isAdminEmailToken() {
      return signedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "sunyeon9501@gmail.com";
    }

    // app shared/auth-helpers.js — hasAnyDirectEventAllow 와 동기화
    function hasDirectEventAllow() {
      return userDocExists() && (
        userDoc().data.get('allowedEvents', {}).size() > 0 ||
        userDoc().data.get('opsTournamentIds', []).size() > 0
      );
    }

    function isDirectOpsAdminRole() {
      return userDocExists() &&
        userDoc().data.get('role', 'user') == 'admin';
    }

    function isAdmin() {
      return signedIn() && (
        isAdminEmailToken() ||
        hasDirectEventAllow() ||
        isDirectOpsAdminRole()
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roleUnchanged() {
      return !("role" in request.resource.data) ||
        !("role" in resource.data) ||
        request.resource.data.role == resource.data.role;
    }

    function accessFieldsUnchanged() {
      return (
        request.resource.data.accessCode == resource.data.accessCode &&
        request.resource.data.allowedEvents == resource.data.allowedEvents
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isAdmin() ||
        (
          isSelf(uid) &&
          roleUnchanged() &&
          accessFieldsUnchanged()
        );
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }

      // NEW: global integrated seats for admin operations
      match /global_seats/{seatDocId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /layout_events/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /layout_shared/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /layout_notifications/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin() ||
        (
          isSelf(uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["acknowledged", "acknowledgedAt", "updatedAt", "updatedAtServer"])
        );
      allow delete: if isAdmin();
    }

    match /dealer_attendance/{docId} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() ||
        (
          signedIn() &&
          docId.matches('.*__' + request.auth.uid)
        );
    }

    match /dealer_attendance_logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // HAN 지원서: 본인만 작성, admin 만 열람·수정·삭제
    // 참고: rules 의 string.size() 는 UTF-8 바이트 길이(글자 수 아님). 한글 필드는 한도를 넉넉히 둔다.
    match /han_applications/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "applicantUid",
          "applicantEmail",
          "name",
          "age",
          "gender",
          "phone",
          "experience",
          "createdAt"
        ]) &&
        request.resource.data.applicantUid == request.auth.uid &&
        request.resource.data.applicantEmail is string &&
        request.resource.data.applicantEmail.size() <= 320 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 400 &&
        request.resource.data.age is string &&
        request.resource.data.age.size() >= 1 &&
        request.resource.data.age.size() <= 60 &&
        request.resource.data.gender is string &&
        request.resource.data.gender.size() >= 1 &&
        request.resource.data.gender.size() <= 60 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 1 &&
        request.resource.data.phone.size() <= 80 &&
        request.resource.data.experience is string &&
        request.resource.data.experience.size() >= 1 &&
        request.resource.data.experience.size() <= 600 &&
        request.resource.data.createdAt is int &&
        request.resource.data.createdAt > 0 &&
        request.resource.data.createdAt <= request.time.toMillis() + 300000;
      allow update, delete: if isAdmin();
    }
  }
}
